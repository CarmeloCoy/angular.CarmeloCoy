{
    "name": "personal-website",
    "description": "Personal website",
    "version": "2.0.0",
    "main": "index.html",
    "scripts": {
        "ng": "ng",
        "start": "ng serve --host 0.0.0.0",
        "start:es": "ng serve --host 0.0.0.0 --configuration es",
        "build": "ng build",
        "deploy": "bash scripts/deploy.sh",
        "watch": "ng build --watch --configuration development",
        "test": "ng test",
        "i18n:extract": "ng extract-i18n --output-path src/locale",
        "i18n:sync": "node scripts/sync-translations.js",
        "i18n": "npm run i18n:extract && npm run i18n:sync",
        "format": "prettier --write .",
        "format:check": "prettier --check ."
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/CarmeloAlcCoy/CarmeloCoy.github.io.git"
    },
    "keywords": [],
    "author": "Carmelo Alcaraz",
    "license": "ISC",
    "bugs": {
        "url": "https://github.com/CarmeloAlcCoy/CarmeloCoy.github.io/issues"
    },
    "homepage": "https://github.com/CarmeloAlcCoy/CarmeloCoy.github.io#readme",
    "dependencies": {
        "@angular/animations": "^22.0.6",
        "@angular/common": "^22.0.6",
        "@angular/compiler": "^22.0.6",
        "@angular/core": "^22.0.6",
        "@angular/forms": "^22.0.6",
        "@angular/platform-browser": "^22.0.6",
        "@angular/platform-browser-dynamic": "^22.0.6",
        "@angular/router": "^22.0.6",
        "rxjs": "~7.8.0",
        "tslib": "^2.3.0",
        "zone.js": "~0.15.0"
    },
    "devDependencies": {
        "@angular/build": "^22.0.6",
        "@angular/cli": "^22.0.6",
        "@angular/compiler-cli": "^22.0.6",
        "@angular/localize": "^22.0.6",
        "@types/jasmine": "~5.1.0",
        "fast-xml-parser": "^5.10.0",
        "jasmine-core": "~5.4.0",
        "pre-commit": "^2.0.0",
        "prettier": "3.3.3",
        "typescript": "~6.0.3",
        "vitest": "^4.0.8"
    },
    "precommit": {
        "run": "format:check"
    }
}